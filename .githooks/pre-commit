#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if REPO_ROOT=$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel 2>/dev/null); then
  :
else
  REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
fi
PROJECT_DIR="$REPO_ROOT/avengine"
BUILD_DIR="$PROJECT_DIR/build"

if [[ ! -f "$PROJECT_DIR/CMakeLists.txt" ]]; then
  echo "pre-commit: $PROJECT_DIR/CMakeLists.txt not found; skipping clang-tidy checks."
  exit 0
fi

if ! command -v cmake >/dev/null 2>&1; then
  echo "pre-commit: cmake is required but was not found in PATH."
  exit 1
fi

if ! command -v clang-tidy >/dev/null 2>&1; then
  echo "pre-commit: clang-tidy is required but was not found in PATH."
  exit 1
fi

FILES=()
while IFS= read -r rel_path; do
  [[ -z "$rel_path" ]] && continue
  case "$rel_path" in
    avengine/src/*|avengine/include/*|avengine/examples/*)
      case "$rel_path" in
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp) FILES+=("${rel_path#avengine/}") ;;
      esac
    ;;
  esac
done < <(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACMR)

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "pre-commit: no staged C/C++ files in avengine; skipping clang-tidy."
  exit 0
fi

echo "pre-commit: configuring CMake for clang-tidy..."
cmake -S "$PROJECT_DIR" -B "$BUILD_DIR" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON >/dev/null

status=0
for rel_path in "${FILES[@]}"; do
  abs_path="$PROJECT_DIR/$rel_path"
  echo "pre-commit: clang-tidy $rel_path"
  if ! clang-tidy -p "$BUILD_DIR" "$abs_path"; then
    status=1
  fi
done

if [[ $status -ne 0 ]]; then
  echo "pre-commit: clang-tidy reported errors in staged files. Commit blocked."
  exit 1
fi

echo "pre-commit: clang-tidy completed for staged files."
