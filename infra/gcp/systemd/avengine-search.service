[Unit]
Description=AVEngine search server
After=network-online.target avengine-aggregate.service
Wants=network-online.target

[Service]
Type=simple
User=engine
Group=engine
EnvironmentFile=/opt/avengine/runtime.env
WorkingDirectory=/avengine
ExecStart=/usr/local/bin/avengine-search-service.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
