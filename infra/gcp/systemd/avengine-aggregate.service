[Unit]
Description=AVEngine aggregate watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=engine
Group=engine
EnvironmentFile=/opt/avengine/runtime.env
WorkingDirectory=/avengine
PIDFile=/data/pids/aggregate.pid
ExecStart=/avengine/bin/start-aggregate-watch.sh
ExecStop=/avengine/bin/stop-aggregate-watch.sh
Restart=on-failure
RestartSec=10
SuccessExitStatus=75
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
