#!/usr/bin/env python3
import sys
import argparse
import struct
from tqdm import tqdm


def unpack_cstr(buffer):
    i = 0
    while buffer[i] != 0:
        i += 1

    return buffer[:i].decode()


parser = argparse.ArgumentParser(
    prog="Index Explorer",
    description="Examine indexes produced by the Avengineers indexer",
)

parser.add_argument("filename")

# TODO: Add flag for verifying integrity of index

args = parser.parse_args()

with open(args.filename, "rb") as binary_file:
    data = binary_file.read()

(document_count, unique_words) = struct.unpack("<QQ", data[:16])

print("Total Number of Documents =", document_count)
print("Total Number of Unique Words =", unique_words)

string_buffer_start = unique_words * 16 * 2 + 16

words = []

for i in tqdm(range(unique_words * 2)):
    offset = i * 16 + 16
    (string_start, posting_start) = struct.unpack(
        "<QQ", data[offset : offset + 16]
    )
    if posting_start != 0:
        term = unpack_cstr(data[string_buffer_start + string_start :])
        words.append((term, posting_start))

print(words)
